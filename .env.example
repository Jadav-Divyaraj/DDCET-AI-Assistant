# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# GROQ_ATTEMPTS_PER_MODEL=2
# GROQ_MAX_RETRY_SECONDS=4
# TELEGRAM_CONNECT_TIMEOUT=20
# TELEGRAM_READ_TIMEOUT=30
# TELEGRAM_WRITE_TIMEOUT=30
# TELEGRAM_POOL_TIMEOUT=10
# TELEGRAM_MEDIA_WRITE_TIMEOUT=60
# TELEGRAM_POLL_TIMEOUT=20
# TELEGRAM_BOOTSTRAP_RETRIES=5
# BOT_TIMEZONE=Asia/Kolkata
# DATABASE_PATH=data/gtu_bot.sqlite3
# UPLOAD_DIR=data/uploads
# KNOWLEDGE_DIR=knowledge/approved
# CONVERSATION_WINDOW=12
# ALLOW_EXTERNAL_DOCUMENT_CONTEXT=true
# MAX_UPLOAD_MB=18
# MAX_PDF_VISION_PAGES=3
